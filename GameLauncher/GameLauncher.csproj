<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>GameLauncher</RootNamespace>
    <AssemblyName>YamanoRealmsLauncher</AssemblyName>
    <ApplicationIcon>TidansIcon2.ico</ApplicationIcon>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Version overridden by CI via -p:Version=... -->
    <Version>1.0.0</Version>
    <Company>Tidan's Realm</Company>
    <Product>Tidan's Realm Game Launcher</Product>
    <AssemblyTitle>Tidan's Realm Game Launcher</AssemblyTitle>
    <Description>Auto-updating launcher for Tidan's Realm.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The auto-generated AssemblyInfo would collide with the legacy
         Properties\AssemblyInfo.cs left over from the old project, so
         exclude that file from compilation. The SDK derives the same
         metadata from the PropertyGroup above. -->
    <Compile Remove="Properties\AssemblyInfo.cs" />
    <Resource Include="Assets\Title_Screen_0.png" />
    <Resource Include="Assets\Title_Screen_1.png" />
    <Resource Include="Assets\Title_Screen_2.png" />
    <Resource Include="Assets\Title_Screen_3.png" />
    <Resource Include="Assets\Title.v1.0.0.png" />
  </ItemGroup>

</Project>
