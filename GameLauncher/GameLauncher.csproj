<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>GameLauncher</RootNamespace>
    <AssemblyName>YamanoRealmsLauncher</AssemblyName>
    <ApplicationIcon>00000-4150202487.ico</ApplicationIcon>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Version overridden by CI via -p:Version=... -->
    <Version>1.0.0</Version>
    <Company>Yamano Realms</Company>
    <Product>Yamano Realms Launcher</Product>
    <AssemblyTitle>Yamano Realms Launcher</AssemblyTitle>
    <Description>Auto-updating launcher for Yamano Realms.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The auto-generated AssemblyInfo would collide with the legacy
         Properties\AssemblyInfo.cs left over from the old project, so
         exclude that file from compilation. The SDK derives the same
         metadata from the PropertyGroup above. -->
    <Compile Remove="Properties\AssemblyInfo.cs" />
  </ItemGroup>

</Project>
