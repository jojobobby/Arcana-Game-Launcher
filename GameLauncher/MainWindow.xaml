<Window x:Class="GameLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameLauncher"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        ContentRendered="Window_ContentRendered"
        ResizeMode="CanMinimize"
        Title="Yamano Realms Launcher"
        SizeToContent="WidthAndHeight"
        Background="#0c1218">
    <!--
        Background is the source image at 1:1 pixel scale (696x448).
        Window auto-sizes to the image so there's no padding/letterbox,
        and ResizeMode is locked so the user can't stretch it and
        re-introduce non-1:1 scaling. UseLayoutRounding + NearestNeighbor
        keep the pixel art crisp on hi-DPI displays.
    -->
    <Grid Width="696" Height="448" UseLayoutRounding="True">
        <Image Source="/Assets/background.png"
               Stretch="None"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="NearestNeighbor"
               RenderOptions.EdgeMode="Aliased"/>
        <TextBlock Name="GameName"
                   Text="Yamano Realms"
                   FontWeight="Bold"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Center"
                   FontSize="36"
                   Foreground="White"
                   Margin="0, 18, 0, 0">
            <TextBlock.Effect>
                <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="2" Opacity="0.85"/>
            </TextBlock.Effect>
        </TextBlock>
        <TextBlock Name="VersionText"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Right"
                   FontSize="11"
                   FontFamily="Consolas"
                   Foreground="White"
                   Margin="0, 0, 8, 8">
            <TextBlock.Effect>
                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.85"/>
            </TextBlock.Effect>
        </TextBlock>
        <Button Name="PlayButton"
                Content="Checking For Updates"
                Click="Play_Click"
                Height="48"
                FontSize="20"
                FontWeight="Bold"
                Margin="0,0,0,20"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                MinWidth="260"/>
    </Grid>
</Window>
