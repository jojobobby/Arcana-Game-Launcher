<Window x:Class="GameLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameLauncher"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        ContentRendered="Window_ContentRendered"
        Title="Yamano Realms Launcher" Height="600" Width="1000">
    <Grid>
        <Image Stretch="UniformToFill" Source="/Assets/02.png" HorizontalAlignment="Right"/>
        <TextBlock Name="GameName" Text="Yamano Realms Launcher" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Center" FontSize="50" Foreground="Black" Margin="0, 25, 0, 0"/>
        <TextBlock Name="VersionText" VerticalAlignment="Bottom" HorizontalAlignment="Right" FontSize="14" FontFamily="Consolas" Foreground="White" Margin="0, 0, 8, 8"/>
        <Button Name="PlayButton" Content="Checking For Updates" Click="Play_Click" Height="60" FontSize="28" FontWeight="Bold" Margin="15,0,0,15" VerticalAlignment="Bottom" HorizontalAlignment="Center" MinWidth="350"/>
    </Grid>
</Window>
