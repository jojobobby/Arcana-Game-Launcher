<Window x:Class="GameLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        ContentRendered="Window_ContentRendered"
        Closing="Window_Closing"
        ResizeMode="CanMinimize"
        Title="Arcana Launcher"
        SizeToContent="WidthAndHeight"
        Background="#071018">
        <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="52"/>
            <Setter Property="MinWidth" Value="260"/>
            <Setter Property="Padding" Value="28,0"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#f4fff3"/>
            <Setter Property="Background" Value="#2f8f52"/>
            <Setter Property="BorderBrush" Value="#9be68f"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.45"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3da964"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#236d3e"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.65"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="UpdateButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="#eef8ff"/>
            <Setter Property="Background" Value="#2f68b7"/>
            <Setter Property="BorderBrush" Value="#9fd1ff"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="116"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3b7fd5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#244f8e"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.65"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="116"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#e7faff"/>
            <Setter Property="Background" Value="#263746"/>
            <Setter Property="BorderBrush" Value="#5d7c8d"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#314b5c"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1a2834"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="#fff4f4"/>
            <Setter Property="Background" Value="#8e2f35"/>
            <Setter Property="BorderBrush" Value="#e88989"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#af3d43"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#692129"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DownloadButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="#eef8ff"/>
            <Setter Property="Background" Value="#2f68b7"/>
            <Setter Property="BorderBrush" Value="#9fd1ff"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3b7fd5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#244f8e"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SmallPlayButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="#f4fff3"/>
            <Setter Property="Background" Value="#2f8f52"/>
            <Setter Property="BorderBrush" Value="#9be68f"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3da964"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#236d3e"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The Live / Development switch: the SecondaryButton look, the selected one in the DownloadButton blue. -->
        <Style x:Key="ChannelSegment" TargetType="ToggleButton">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#b9d7df"/>
            <Setter Property="Background" Value="#d9132029"/>
            <Setter Property="BorderBrush" Value="#4f6b7a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#314b5c"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2f68b7"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#9fd1ff"/>
                                <Setter Property="Foreground" Value="#eef8ff"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Width="696" Height="448" UseLayoutRounding="True">
        <Image Name="BackgroundImageA"
               Source="/Assets/Title_Screen_0.png"
               Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="NearestNeighbor"
               RenderOptions.EdgeMode="Aliased"/>
        <Image Name="BackgroundImageB"
               Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Opacity="0"
               RenderOptions.BitmapScalingMode="NearestNeighbor"
               RenderOptions.EdgeMode="Aliased"/>

        <Rectangle Fill="#66071118"/>
        <Rectangle VerticalAlignment="Bottom" Height="174">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0"/>
                    <GradientStop Color="#d9071118" Offset="0.55"/>
                    <GradientStop Color="#f0071118" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <StackPanel VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Margin="0,6,0,0">
            <Image Source="/Assets/Logo.png"
                   Width="300"
                   Height="136"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <!-- Which servers: Live (production) or Development. Each has its own game folder; the pick is saved. -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,6,0,0">
                <ToggleButton Name="LiveButton"
                              Style="{StaticResource ChannelSegment}"
                              Content="Live"
                              Checked="Live_Checked"
                              Unchecked="Segment_Unchecked"
                              Margin="0,0,6,0"/>
                <ToggleButton Name="DevelopmentButton"
                              Style="{StaticResource ChannelSegment}"
                              Content="Development"
                              Checked="Development_Checked"
                              Unchecked="Segment_Unchecked"/>
            </StackPanel>
        </StackPanel>

        <!-- Shown on a copy run from outside its install (Downloads): offers the installer; and after a move, says so. -->
        <Border Name="Banner"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Width="548"
                Margin="0,186,0,0"
                Background="#e60b1822"
                BorderBrush="#4f6b7a"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Name="BannerTitle"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#fff8e8"/>
                    <TextBlock Name="BannerText"
                               FontSize="12"
                               Foreground="#b9d7df"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0"/>
                </StackPanel>
                <Button Name="BannerButton"
                        Grid.Column="1"
                        Style="{StaticResource DownloadButton}"
                        VerticalAlignment="Center"
                        Click="Banner_Click"/>
            </Grid>
        </Border>

        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Width="548"
              MinHeight="176"
              Margin="0,0,0,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,18,0">
                    <TextBlock Name="StatusText"
                               Text="Checking for updates..."
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#fff8e8"/>
                    <TextBlock Name="DetailText"
                               Text="app.tidansrealm.com"
                               FontSize="12"
                               Foreground="#b9d7df"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="0"
                            Grid.Column="1"
                            VerticalAlignment="Top">
                    <TextBlock Name="VersionText"
                               FontSize="12"
                               FontFamily="Consolas"
                               Foreground="#e7faff"
                               TextAlignment="Right"/>
                    <TextBlock Name="LauncherVersionText"
                               FontSize="12"
                               FontFamily="Consolas"
                               Foreground="#9fb6c1"
                               TextAlignment="Right"
                               Margin="0,3,0,0"/>
                    <TextBlock FontSize="12"
                               TextAlignment="Right"
                               Margin="0,3,0,0">
                        <Hyperlink Name="OpenLogsLink"
                                   Foreground="#9fd1ff"
                                   Click="OpenLogs_Click">Open logs</Hyperlink>
                    </TextBlock>
                </StackPanel>

                <ProgressBar Name="UpdateProgress"
                             Grid.Row="1"
                             Grid.ColumnSpan="2"
                             Height="8"
                             Margin="0,18,0,18"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Background="#293744"
                             Foreground="#57d684"
                             BorderThickness="0"/>

                <Grid Grid.Row="2" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Name="ServerStatusDot"
                                 Width="9"
                                 Height="9"
                                 Fill="#7b8790"
                                 Margin="0,0,7,0"/>
                        <TextBlock Name="ServerStatusText"
                                   Text="Server: checking"
                                   FontSize="12"
                                   Foreground="#d8f4ff"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="  /  "
                                   FontSize="12"
                                   Foreground="#6d8794"
                                   VerticalAlignment="Center"/>
                        <TextBlock Name="LatencyText"
                                   Text="-- ms"
                                   FontSize="12"
                                   Foreground="#d8f4ff"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Name="OpenFolderButton"
                                Style="{StaticResource SecondaryButton}"
                                Content="Open Folder"
                                Click="OpenFolder_Click"
                                Margin="0,0,8,0"/>
                        <Button Name="PlayButton"
                                Style="{StaticResource DownloadButton}"
                                Content="Install"
                                Click="Play_Click"/>
                    </StackPanel>
                </Grid>
        </Grid>

        <Button Name="UpdateButton"
                Style="{StaticResource UpdateButton}"
                Content="Update"
                Click="Update_Click"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="18,0,0,18"/>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,18,18">
            <Button Name="VerifyButton"
                    Style="{StaticResource SecondaryButton}"
                    Content="Verify Files"
                    Click="Verify_Click"
                    Margin="0,0,8,0"/>
            <Button Name="UninstallButton"
                    Style="{StaticResource DangerButton}"
                    Content="Uninstall"
                    Click="Uninstall_Click"/>
        </StackPanel>
    </Grid>
</Window>
